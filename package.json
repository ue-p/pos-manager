{
  "name": "gakusai-pos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:no-sw": "tsc --noEmit -p tsconfig.json && vite build --mode nosw",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-gakusai-pos",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-gakusai-pos \"vitest run --config vitest.rules.config.ts\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-gakusai-pos \"playwright test && playwright test -c playwright.pwa.config.ts\""
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "jszip": "^3.10.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^13.35.1",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "^3.2.7"
  }
}
