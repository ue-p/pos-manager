rules_version = '2';

// D-16：部員共通アカウントだけが読み書きできる。display_state だけは誰でも読める。
service cloud.firestore {
  match /databases/{database}/documents {

    // 部員共通アカウントのメールアドレス。
    // 本番では Firebase コンソールで作ったアカウントに書き換え、.env.local の VITE_SHARED_ACCOUNT_EMAIL とそろえる。
    function sharedEmail() {
      return 'staff@gakusai-pos.example';
    }

    function isStaff() {
      return request.auth != null && request.auth.token.email == sharedEmail();
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 更新は取消（is_void / voided_at）だけ。オフライン復帰時の再送で created_at が変わるのは許す。
    // 取消の取り消し（true → false）はできない。
    function isVoidOnlyUpdate() {
      return changedKeys().hasOnly(['is_void', 'voided_at', 'created_at'])
        && (resource.data.is_void == false || request.resource.data.is_void == true)
        && (request.resource.data.is_void == false || request.resource.data.voided_at is string);
    }

    // 作成のみの記録で、再送による created_at の更新だけ許す
    function isResendOnly() {
      return changedKeys().hasOnly(['created_at']);
    }

    match /transactions/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.transaction_id == id
        && request.resource.data.is_void == false
        && request.resource.data.total is int
        && request.resource.data.lines is list
        && request.resource.data.is_test is bool;
      allow update: if isStaff() && isVoidOnlyUpdate();
      allow delete: if false;
    }

    match /vr_visits/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.visit_id == id
        && request.resource.data.is_void == false
        && request.resource.data.is_test is bool;
      allow update: if isStaff() && isVoidOnlyUpdate();
      allow delete: if false;
    }

    function settingsAfter() {
      return getAfter(/databases/$(database)/documents/settings/current).data;
    }

    // D-24：テストモード切替の記録は、同じバッチで settings が切り替わり、その記録を指している場合だけ作れる。
    // 自動記録は常に is_test == false。
    function isValidActionLog(id) {
      let d = request.resource.data;
      return d.log_id == id
        && (d.log_type == 'manual'
          || (d.log_type in ['test_mode_on', 'test_mode_off']
            && d.is_test == false
            && settingsAfter().get('test_mode_log_id', '') == id
            && settingsAfter().get('test_mode', false) == (d.log_type == 'test_mode_on')));
    }

    match /action_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && isValidActionLog(id);
      allow update: if isStaff() && isResendOnly();
      allow delete: if false;
    }

    match /register_closings/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.closing_id == id;
      allow update: if isStaff() && isResendOnly();
      allow delete: if false;
    }

    // D-24：test_mode を変える書き込みは、同じバッチで対応する施策ログ（test_mode_log_id）を作るときだけ通す
    function isTestModeChangeLogged() {
      let before = resource == null ? false : resource.data.get('test_mode', false);
      let after = request.resource.data.get('test_mode', false);
      let logId = request.resource.data.get('test_mode_log_id', '');
      return before == after
        || (logId is string && logId != ''
          && !exists(/databases/$(database)/documents/action_logs/$(logId))
          && getAfter(/databases/$(database)/documents/action_logs/$(logId)).data.log_type
            == (after ? 'test_mode_on' : 'test_mode_off'));
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow create, update: if isStaff() && isTestModeChangeLogged();
      allow delete: if false;
    }

    // お客さん用画面の表示内容（会計データではないので上書き可）。読み取りは誰でも可
    match /display_state/{registerId} {
      allow read: if true;
      allow write: if isStaff() && request.resource.data.register_id == registerId;
    }
  }
}
